{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @balik/web",
  "outputDirectory": "packages/web/dist",
  "rewrites": [
    { "source": "/decks/biopunk", "destination": "/index.html" },
    { "source": "/decks/biopunk/", "destination": "/index.html" },
    { "source": "/decks/panelak-3000", "destination": "/index.html" },
    { "source": "/decks/panelak-3000/", "destination": "/index.html" },
    { "source": "/decks/chalupa", "destination": "/index.html" },
    { "source": "/decks/chalupa/", "destination": "/index.html" },
    { "source": "/decks/papirovy-cirkus", "destination": "/index.html" },
    { "source": "/decks/papirovy-cirkus/", "destination": "/index.html" },
    { "source": "/r/:code", "destination": "/index.html" },
    { "source": "/decks/retro-arcade", "destination": "/index.html" },
    { "source": "/decks/retro-arcade/", "destination": "/index.html" },
    { "source": "/decks/mariasky", "destination": "/index.html" },
    { "source": "/decks/mariasky/", "destination": "/index.html" },
    { "source": "/decks/strasidla", "destination": "/index.html" },
    { "source": "/decks/strasidla/", "destination": "/index.html" },
    { "source": "/decks/kontrast", "destination": "/index.html" },
    { "source": "/decks/kontrast/", "destination": "/index.html" },
    { "source": "/dev/:path*", "destination": "/index.html" }
  ]
}
