{
  "name": "balik",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w @balik/server\" \"npm:dev -w @balik/web\"",
    "build": "npm run build -w @balik/web && npm run build -w @balik/server",
    "start": "npm run start -w @balik/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/server --noEmit && tsc -p packages/web --noEmit",
    "bot": "npm run bot -w @balik/server --",
    "qa:e2e": "node scripts/e2e-play.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
