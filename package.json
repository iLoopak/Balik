{
  "name": "balik",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w @balik/server\" \"npm:dev -w @balik/web\"",
    "build": "npm run build -w @balik/web && npm run build -w @balik/server",
    "start": "npm run start -w @balik/server",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/backend --noEmit && tsc -p packages/server --noEmit && tsc -p packages/web --noEmit",
    "build:supabase": "node scripts/build-supabase.mjs",
    "qa:supabase": "node --import tsx scripts/qa-supabase.mts",
    "preview:brand": "node scripts/preview-brand.mjs",
    "bot": "npm run bot -w @balik/server --",
    "qa:e2e": "node scripts/e2e-play.mjs",
    "qa:sedma": "node scripts/e2e-sedma.mjs",
    "qa:evening": "node scripts/e2e-evening.mjs",
    "qa:themes": "node scripts/e2e-themes.mjs",
    "qa:showroom": "node --import tsx scripts/e2e-showroom.mjs",
    "qa:experience": "node scripts/e2e-experience.mjs",
    "qa:assets": "node scripts/audit-deck-assets.mjs",
    "art:retro": "node scripts/create-retro-arcade.mjs",
    "art:worlds": "node scripts/create-world-editions.mjs",
    "qa:world-assets": "node scripts/audit-world-editions.mjs",
    "art:premium-poc": "node scripts/prepare-premium-poc.mjs",
    "art:premium-plan": "node scripts/plan-premium-series.mjs",
    "qa:premium-assets": "node scripts/audit-premium-series.mjs",
    "qa:lhar": "node --import tsx scripts/e2e-lhar.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
