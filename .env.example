# Optional frontend setting for any hosting provider: set before the Vite build.
# Leave unset for a single-domain deployment with /ws on the web's own origin.
# Use the public TLS hostname of the separately running Node backend, including /ws.
# VITE_WS_URL=wss://your-backend.example.com/ws

# Standalone Node backend; the hosting platform may inject PORT automatically.
# PORT=8787
# HOST=0.0.0.0
# Select the transport; local npm run dev keeps the standalone Node/WebSocket backend.
# VITE_GAME_BACKEND=websocket

# Supabase mode (public configuration only; use the project's publishable or legacy anon key).
# VITE_GAME_BACKEND=supabase
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
